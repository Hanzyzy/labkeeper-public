# LabKeeper — Environment Configuration
# Copy ke .env (jangan commit ke Git!)

# Flask secret key — GANTI dengan string random saat deploy!
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-random-string-32-karakter-di-sini

# Set true hanya jika aplikasi berada tepat di belakang satu reverse proxy
# tepercaya (misalnya Nginx dari deploy_vps.sh).
TRUST_PROXY=false
SESSION_COOKIE_SECURE=false

# Aktifkan hanya saat sengaja ingin membuat akun demo awal.
LABKEEPER_SEED=false

# Wajib diisi minimal 8 karakter hanya ketika LABKEEPER_SEED=true atau
# ketika menjalankan reset_db.py.
LABKEEPER_ADMIN_PASSWORD=
LABKEEPER_STUDENT_PASSWORD=

# URL base untuk QR codes (ganti saat deploy ke Railway)
BASE_URL=http://localhost:5000

# Password untuk service sqlite-web (jika service tersebut digunakan).
SQLITE_WEB_PASSWORD=ganti-dengan-password-kuat-yang-unik
